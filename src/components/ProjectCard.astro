---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, description, tech, status, year, link, repo } = project.data;
---

<article
  class="group relative flex flex-col rounded-lg border border-border bg-card p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50"
>
  <div class="mb-2 flex items-center justify-between">
    <h3 class="font-semibold tracking-tight">
      <!-- 拉伸链接：标题链接铺满整卡，实现"点卡片任意位置进详情" -->
      <a
        href={`/projects/${project.id}/`}
        class="after:absolute after:inset-0 group-hover:text-primary"
      >
        {name}
      </a>
    </h3>
    <span class="flex shrink-0 items-center gap-1.5 font-mono text-[11px] text-muted">
      <span class:list={[
        "h-1.5 w-1.5 rounded-full",
        status === "进行中" ? "bg-primary" : "bg-accent",
      ]}></span>
      {status} · {year}
    </span>
  </div>

  <p class="flex-1 text-sm leading-relaxed text-muted">{description}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {
      tech.map((t) => (
        <span class="rounded bg-primary/10 px-2 py-0.5 font-mono text-[11px] text-primary">
          {t}
        </span>
      ))
    }
  </div>

  {
    (link || repo) && (
      <div class="relative z-10 mt-4 flex gap-3 border-t border-border pt-3 text-sm">
        {link && (
          <a
            href={link}
            target="_blank"
            rel="noopener"
            class="text-primary hover:underline underline-offset-4"
          >
            访问 →
          </a>
        )}
        {repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener"
            class="text-muted hover:text-primary"
          >
            源码
          </a>
        )}
      </div>
    )
  }
</article>
