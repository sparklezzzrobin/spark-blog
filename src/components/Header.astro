---
const navLinks = [
  { href: "/posts/", label: "文章" },
  { href: "/projects/", label: "项目" },
  { href: "/about/", label: "关于" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href.replace(/\/$/, ""));
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-14 max-w-4xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-mono text-base font-semibold tracking-tight">
      spark<span class="text-primary">.geo</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-md px-3 py-1.5 text-sm transition-colors hover:text-primary",
              isActive(link.href) ? "text-primary" : "text-muted",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <button
        id="theme-toggle"
        type="button"
        aria-label="切换深色 / 浅色模式"
        class="ml-1 flex h-8 w-8 items-center justify-center rounded-md text-muted transition-colors hover:text-primary"
      >
        <!-- 月亮（浅色模式下显示，点击进入暗色） -->
        <svg
          class="h-4 w-4 dark:hidden"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.752 15.007A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
          ></path>
        </svg>
        <!-- 太阳（暗色模式下显示，点击回到浅色） -->
        <svg
          class="hidden h-4 w-4 dark:block"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
          ></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");

  function setTheme(isDark: boolean) {
    document.documentElement.classList.toggle("dark", isDark);
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }

  toggle?.addEventListener("click", (event) => {
    const isDark = !document.documentElement.classList.contains("dark");

    // 不支持 View Transitions、或用户偏好减少动效：直接切换
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!document.startViewTransition || reduceMotion) {
      setTheme(isDark);
      return;
    }

    // 键盘触发时 clientX/Y 为 0，回退到按钮中心作为圆心
    const rect = toggle.getBoundingClientRect();
    const x = event.clientX || rect.left + rect.width / 2;
    const y = event.clientY || rect.top + rect.height / 2;

    // 圆半径取圆心到视口四个角的最大距离，保证铺满
    const endRadius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y),
    );

    const transition = document.startViewTransition(() => setTheme(isDark));

    transition.ready
      .then(() => {
        // 圆心与半径都用百分比表达：部分浏览器在 DPR≠1（显示缩放）时，
        // view-transition 伪元素坐标系与 CSS 像素存在缩放差，px 值会让圆心
        // 偏移、半径不足；百分比相对伪元素自身盒子解析，不受缩放影响。
        // circle() 的百分比半径按 sqrt(w²+h²)/√2 解析，故换算出等效百分比。
        const cx = ((x / innerWidth) * 100).toFixed(3);
        const cy = ((y / innerHeight) * 100).toFixed(3);
        const r =
          ((endRadius * Math.SQRT2 * 100) / Math.hypot(innerWidth, innerHeight)).toFixed(3);
        // 两个方向都从按钮向外"发布"新主题的遮罩（不反向收回）
        const circle = [
          `circle(0% at ${cx}% ${cy}%)`,
          `circle(${r}% at ${cx}% ${cy}%)`,
        ];
        document.documentElement.animate(
          { clipPath: circle },
          {
            duration: 500,
            easing: "cubic-bezier(0.4, 0, 0.2, 1)",
            pseudoElement: "::view-transition-new(root)",
          },
        );
      })
      .catch(() => {});
  });
</script>
