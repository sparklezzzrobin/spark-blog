---

<article class="rounded-lg border border-border bg-card p-6">
  <div class="flex items-center gap-5 sm:gap-6">
    <img
      src={SITE.avatar}
      alt={`${SITE.name} 的头像`}
      width="80"
      height="80"
      decoding="async"
      class="h-20 w-20 shrink-0 rounded-full border border-border object-cover"
    />
    <div class="min-w-0">
      <h2 class="text-xl font-bold tracking-tight">{SITE.name}</h2>
      <p class="mt-0.5 font-mono text-sm text-primary">@{SITE.handle}</p>
      <p class="mt-1.5 text-sm text-muted">{SITE.role}</p>
      <p class="mt-2 text-sm leading-6 text-muted">
        <span class="text-accent">「</span>{SITE.signature}<span class="text-accent">」</span>
      </p>
      <p class="mt-2.5 font-mono text-xs text-muted">
        {postCount} 篇文章 · {projectCount} 个项目
      </p>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-2.5 border-t border-border pt-4">
    {
      socials.map(({ label, icon, href }) => {
        const { d, filled } = icons[icon];
        const external = href.startsWith("http");
        return (
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener" : undefined}
            class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-sm text-muted transition-colors hover:border-primary/50 hover:text-primary"
          >
            {filled ? (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={d} />
              </svg>
            ) : (
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={d} />
              </svg>
            )}
            {label}
          </a>
        );
      })
    }
  </div>
</article>
