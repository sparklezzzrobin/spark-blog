---
import { SITE } from "../config";

interface Props {
  postCount: number;
  projectCount: number;
}

const { postCount, projectCount } = Astro.props;

const socials = Object.values(SITE.socials);

// 社交图标：统一用品牌官方 fill 路径（simple-icons 风格，24x24 viewBox）
