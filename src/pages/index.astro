---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostRow from "../components/PostRow.astro";
import ProjectCard from "../components/ProjectCard.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 5);

const featuredProjects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const directions = [
  "gis",
  "remote-sensing",
  "python",
  "algorithms",
  "data-viz",
  "web",
];
---

<Layout title="spark.geo">
  <!-- 1. Hero：10 秒内说明"你是谁、做什么" -->
  <section class="relative overflow-hidden border-b border-border">
    <!-- 等高线纹理：GIS 隐喻，克制地退到背景 -->
    <svg
      class="pointer-events-none absolute -right-32 -top-24 h-[28rem] w-[28rem] text-border opacity-70 dark:opacity-40"
      viewBox="0 0 400 400"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      aria-hidden="true"
    >
      <path d="M200 40c70 0 130 50 140 120s-40 150-110 170S80 310 60 240 90 90 200 40Z" />
      <path d="M205 75c55 8 100 45 108 98s-28 118-88 134-135-25-150-90S110 62 205 75Z" />
      <path d="M210 110c40 10 72 38 78 78s-20 88-68 100-98-20-108-70 40-120 98-108Z" />
      <path d="M215 145c28 8 48 28 52 56s-12 60-45 68-64-14-71-46 26-86 64-78Z" />
      <path d="M220 180c15 6 26 18 28 34s-6 34-24 39-34-8-38-28 14-49 34-45Z" />
      <circle cx="222" cy="210" r="2.5" class="text-primary" fill="currentColor" stroke="none" />
    </svg>

    <div class="relative mx-auto max-w-4xl px-4 py-24 sm:px-6 sm:py-28">
      <div class="fade-up">
        <p class="mb-4 font-mono text-sm text-primary">
          // spark 的个人站 · est. 2026
        </p>
        <h1 class="max-w-2xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          记录地理空间与<span class="text-primary">数据</span>的学习实践
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          GIS · 遥感 · Python · 数据可视化。在这里写下学习笔记、项目过程与踩坑复盘，
          把"做过"沉淀成"学会"。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/posts/"
            class="rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-strong"
          >
            浏览文章
          </a>
          <a
            href="/about/"
            class="rounded-md border border-border px-5 py-2.5 text-sm font-medium text-muted transition-colors hover:border-primary/50 hover:text-primary"
          >
            关于我
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 精选项目：首页的说服任务是"这个人能做什么" -->
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-xl font-bold tracking-tight">精选项目</h2>
      <a href="/projects/" class="text-sm text-muted hover:text-primary">
        全部项目 →
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- 3. 最新文章：体现"这里持续在更新" -->
  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <div class="mb-2 flex items-baseline justify-between">
      <h2 class="text-xl font-bold tracking-tight">最新文章</h2>
      <a href="/posts/" class="text-sm text-muted hover:text-primary">
        查看全部 →
      </a>
    </div>
    <div class="divide-y divide-border">
      {latestPosts.map((post) => <PostRow post={post} />)}
    </div>
  </section>

  <!-- 4. 方向速览：低成本的技术档案感 + SEO 关键词 -->
  <section class="border-t border-border bg-card/50">
    <div
      class="mx-auto flex max-w-4xl flex-wrap items-center gap-2 px-4 py-6 sm:px-6"
    >
      <span class="mr-2 font-mono text-xs text-muted">focus:</span>
      {
        directions.map((d) => (
          <span class="rounded border border-border px-2.5 py-1 font-mono text-xs text-muted">
            {d}
          </span>
        ))
      }
    </div>
  </section>
</Layout>
